# Dockerfile para el Cloud Run Service de predicciones (13e-2).
# Artefacto separado del Dockerfile del ingest_job (Decisión 7: un Dockerfile
# por artefacto). Mismas capas lock → install → código que el job.

FROM python:3.12-slim

WORKDIR /app

# Capas ordenadas de menor a mayor frecuencia de cambio:
# 1. Lock (cambia solo cuando cambian las deps)
COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock

# 2. Código del paquete (sin data/, tests/, notebooks/, .env — ver .dockerignore)
COPY nba_predictor/ ./nba_predictor/

# Cloud Run inyecta $PORT (siempre 8080 en prod); el default cubre tests locales.
ENV PORT=8080
EXPOSE 8080

# exec garantiza que uvicorn recibe señales (PID 1) — necesario para shutdown limpio.
CMD exec uvicorn nba_predictor.api.server:app --host 0.0.0.0 --port $PORT
